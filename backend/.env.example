# Environment & Server
PROJECT_NAME="Waypoint Logistics & Fleet Management API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS (Frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite for immediate out-of-the-box development:
DATABASE_URL="sqlite+aiosqlite:///./waypoint.db"
# For production (PostgreSQL + PostGIS on Supabase / Neon):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/waypoint_db"

# Cache & Redis (Optional / Upstash in production)
REDIS_URL="redis://localhost:6379/0"

# Gemini AI Assistant & RAG Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_PROJECT_NAME="projects/854827363499"
GEMINI_PROJECT_NUMBER="854827363499"
